ADAMS_PORT=4317
ADAMS_HOST=127.0.0.1
# ADAMS_DATA_DIR=.data
# Shared HTTPS deployment: set external origin, a stable encryption key and an invitation code.
# ADAMS_ORIGIN=https://adams.example.org
# ADAMS_MASTER_KEY=
# ADAMS_INVITE_CODE=
# Set to 1 only when a reverse proxy you control sets X-Forwarded-For (per-client login limits).
# ADAMS_TRUST_PROXY=1
# ADAMS_PDFTOTEXT=C:/path/to/pdftotext.exe
# ADAMS_PYTHON=C:/path/to/python.exe
